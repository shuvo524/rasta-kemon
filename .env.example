# RASTA KEMON — environment variables (DO NOT put real secrets here)
# Copy to .env.local for local dev, or set them in Vercel → Project → Settings → Environment Variables.

# App URL (production: https://rasta-kemon.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas connection string (Phase B — REQUIRED for DB, auth, admin)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Better Auth (Phase B — REQUIRED for login; production needs a real random secret)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Phase B — OPTIONAL; login form hides Google until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary image uploads (Phase B — OPTIONAL; photo upload answers 503 until set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
